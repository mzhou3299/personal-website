---
interface Props {
  title: string;
  description: string;
  tech: string;
  href: string;
  imageSrc: string;
  imageAlt: string;
}
const { title, description, tech, href, imageSrc, imageAlt } = Astro.props as Props;
const techItems = tech.split(' · ');
---
<a href={href} class="card project-card reveal block" target="_blank" rel="noreferrer">
  <div class="card-inner grid gap-6 md:grid-cols-[0.84fr_1.16fr] md:items-center">
    <div>
      <div class="project-preview">
        <img src={imageSrc} alt={imageAlt} class="project-image" loading="lazy" />
      </div>
    </div>
    <div>
      <div class="flex items-start justify-between gap-4">
        <h3 class="text-xl font-bold text-white">{title}</h3>
        <span class="project-arrow" aria-hidden="true">↗</span>
      </div>
      <p class="mt-3 text-sm leading-7 text-slate-300">{description}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {techItems.map((item) => (
          <span class="tech-pill">
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>
</a>
