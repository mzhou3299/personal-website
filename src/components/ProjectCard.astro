---
interface Props {
  title: string;
  description: string;
  tech: string;
}
const { title, description, tech } = Astro.props as Props;
---
<article class="card">
  <div class="card-inner">
    <h3 class="text-xl font-semibold text-slate-900 dark:text-white">{title}</h3>
    <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">{description}</p>
    <p class="mt-5 text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">{tech}</p>
  </div>
</article>
