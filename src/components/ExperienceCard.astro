---
interface Props {
  role: string;
  company: string;
  dates: string;
  description: string;
}
const { role, company, dates, description } = Astro.props as Props;
---
<article class="card">
  <div class="card-inner">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{role}</h3>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{company}</p>
      </div>
      <p class="text-sm text-slate-500 dark:text-slate-400">{dates}</p>
    </div>
    <p class="mt-4 text-sm leading-7 text-slate-600 dark:text-slate-300">{description}</p>
  </div>
</article>
