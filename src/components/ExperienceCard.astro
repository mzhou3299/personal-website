---
interface Props {
  role: string;
  company: string;
  dates: string;
  description: string;
}
const { role, company, dates, description } = Astro.props as Props;
---
<article class="card experience-card reveal">
  <div class="card-inner">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h3 class="text-base font-bold text-white">{role}</h3>
        <p class="experience-company mt-1.5">{company}</p>
      </div>
      <p class="date-pill">{dates}</p>
    </div>
    <p class="mt-5 text-sm leading-7 text-slate-300">{description}</p>
  </div>
</article>
