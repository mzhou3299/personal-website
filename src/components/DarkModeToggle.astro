<button
  id="dark-mode-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Switch to light mode"
  aria-pressed="true"
  title="Switch to light mode"
>
  <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="3.5"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
    </svg>
  </span>
  <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z"></path>
    </svg>
  </span>
  <span class="theme-toggle__thumb" aria-hidden="true"></span>
</button>

<script>
const button = document.getElementById('dark-mode-toggle');
const storageKey = 'portfolio-dark-mode';
const root = document.documentElement;

if (button) {
  const updateMode = (mode) => {
    const isDark = mode === 'dark';
    root.classList.toggle('dark', isDark);
    button.setAttribute('aria-pressed', String(isDark));
    button.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} mode`);
    button.setAttribute('title', `Switch to ${isDark ? 'light' : 'dark'} mode`);
  };

  let currentMode = localStorage.getItem(storageKey) || 'dark';
  updateMode(currentMode);

  button.addEventListener('click', () => {
    currentMode = currentMode === 'dark' ? 'light' : 'dark';
    updateMode(currentMode);
    localStorage.setItem(storageKey, currentMode);
  });
}
</script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    width: 3.75rem;
    height: 2rem;
    flex: none;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.42rem;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 999px;
    color: #64748b;
    background:
      radial-gradient(circle at 25% 20%, rgba(251, 191, 36, 0.18), transparent 42%),
      rgba(241, 245, 249, 0.9);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 5px 16px rgba(15, 23, 42, 0.12);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: rgba(96, 165, 250, 0.7);
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 8px 20px rgba(37, 99, 235, 0.18);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid #60a5fa;
    outline-offset: 3px;
  }

  .theme-toggle__icon {
    z-index: 1;
    width: 0.82rem;
    height: 0.82rem;
    transition: color 180ms ease, opacity 180ms ease;
  }

  .theme-toggle__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .theme-toggle__icon--sun {
    color: #d97706;
  }

  .theme-toggle__icon--moon {
    color: #94a3b8;
    opacity: 0.58;
  }

  .theme-toggle__thumb {
    position: absolute;
    top: 0.22rem;
    left: 0.22rem;
    width: 1.42rem;
    height: 1.42rem;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 50%;
    background: linear-gradient(145deg, #ffffff, #e2e8f0);
    box-shadow: 0 2px 7px rgba(15, 23, 42, 0.25);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 180ms ease;
  }

  :global(html.dark) .theme-toggle {
    color: #cbd5e1;
    border-color: rgba(96, 165, 250, 0.36);
    background:
      radial-gradient(circle at 78% 30%, rgba(96, 165, 250, 0.24), transparent 45%),
      rgba(15, 23, 42, 0.9);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 5px 18px rgba(2, 6, 23, 0.32);
  }

  :global(html.dark) .theme-toggle__icon--sun {
    color: #64748b;
    opacity: 0.55;
  }

  :global(html.dark) .theme-toggle__icon--moon {
    color: #bfdbfe;
    opacity: 1;
  }

  :global(html.dark) .theme-toggle__thumb {
    transform: translateX(1.68rem);
    border-color: rgba(191, 219, 254, 0.34);
    background: linear-gradient(145deg, #334155, #172033);
    box-shadow: 0 2px 9px rgba(2, 6, 23, 0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle__icon,
    .theme-toggle__thumb {
      transition-duration: 1ms;
    }
  }
</style>
